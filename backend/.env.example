# Backend runtime environment
# Most runtime values can be edited in backend/config.json.
# Environment variables here override config.json, which is useful for deployment.
# Use production in deployed environments. Production mode disables API docs
# and refuses weak secrets or wildcard host/origin allowlists.
APP_ENV=development

# Optional path to a different JSON config file
BACKEND_CONFIG_PATH=./config.json

# Set a strong random secret in production; minimum 32 characters.
JWT_SECRET_KEY=replace-with-strong-secret

# Production database. Leave commented/unset for local SQLite fallback at backend/data/mmwave.db.
# DATABASE_URL=postgresql://mmwave_app:replace-with-db-password@localhost:5432/mmwave_dashboard

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,https://app.yourdomain.com

# Comma-separated host allowlist for Host header validation
TRUSTED_HOSTS=localhost,127.0.0.1,::1,api.yourdomain.com

# API bind configuration
API_HOST=0.0.0.0
API_PORT=8000

# Auth endpoint rate limiting (per IP per endpoint)
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=30

# Automation execution
AUTOMATION_SCHEDULER_INTERVAL_SECONDS=30
AUTOMATION_EVENT_COOLDOWN_SECONDS=60

# ESP32 BLE provisioning config
BLE_PROVISION_SERVICE_UUID=6e400001-b5a3-f393-e0a9-e50e24dcca9e
BLE_PROVISION_RX_UUID=6e400002-b5a3-f393-e0a9-e50e24dcca9e
BLE_PROVISION_DEVICE_PREFIXES=mmWave,ESP32
