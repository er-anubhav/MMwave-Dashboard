{
  "identity": {
    "persona": "E1: The Anti-AI Designer",
    "principles": [
      "Fusion over Imitation",
      "Emotion First",
      "Content is King",
      "Zoom In",
      "Negative Space",
      "Contrast"
    ]
  },
  "project_context": {
    "name": "mmWave Smart Switch Dashboard",
    "type": "IoT Dashboard",
    "theme": "Light (Clinical Zen)",
    "emotional_tone": "Precise, Reliable, Calm, Scientific",
    "target_audience": "Developers, Researchers, Medical Testers"
  },
  "design_system": {
    "typography": {
      "strategy": "The Old Money Tech (Serif Head + Sterile Mono Body)",
      "fonts": {
        "heading": {
          "family": "Playfair Display, serif",
          "usage": "Page titles, Section headers, Big States",
          "weights": ["400", "600", "700"]
        },
        "body": {
          "family": "Manrope, sans-serif",
          "usage": "UI labels, descriptions, navigation",
          "weights": ["400", "500"]
        },
        "mono": {
          "family": "JetBrains Mono, monospace",
          "usage": "Sensor data, coordinates, timestamps, debug logs",
          "weights": ["400"]
        }
      },
      "rules": [
        "Headings > 32px must use tracking-tight",
        "Overlines must be Uppercase + tracking-widest + text-xs",
        "Data values must use Mono font for alignment"
      ]
    },
    "colors": {
      "palette_name": "Clinical Zen",
      "background": {
        "default": "#FAFAF9",
        "paper": "#FFFFFF",
        "subtle": "#F5F5F4"
      },
      "foreground": {
        "default": "#1C1917",
        "muted": "#78716C",
        "inverse": "#FFFFFF"
      },
      "primary": {
        "default": "#1C1917",
        "foreground": "#FFFFFF"
      },
      "accents": {
        "fall_alert": "#DC2626",
        "fall_safe": "#16A34A",
        "sleep_calm": "#4F46E5",
        "sleep_deep": "#1E1B4B",
        "relay_on": "#F59E0B"
      },
      "borders": {
        "default": "#E7E5E4",
        "active": "#A8A29E"
      }
    },
    "spacing": {
      "scale": "Generous (2x standard)",
      "container_padding": "p-8 md:p-12",
      "grid_gap": "gap-6 md:gap-8",
      "internal_padding": "p-6"
    },
    "visual_enhancers": {
      "radius": "rounded-none",
      "shadows": {
        "card": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
        "hover": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)"
      },
      "borders": "1px solid #E7E5E4",
      "textures": "Subtle noise overlay on background (optional)"
    }
  },
  "layout_strategy": {
    "type": "Bento Grid (Mode B: High Density)",
    "grid_cols": "grid-cols-1 md:grid-cols-4 lg:grid-cols-12",
    "sections": {
      "header": {
        "style": "Minimalist, sticky top, glassmorphism (white/80)",
        "elements": ["Logo (Serif)", "Mode Switcher (Toggle)", "Connection Status"]
      },
      "main_dashboard": {
        "fall_mode": [
          {"name": "Presence Status", "span": "col-span-full md:col-span-6 lg:col-span-4", "type": "Big Metric"},
          {"name": "Fall State", "span": "col-span-full md:col-span-6 lg:col-span-4", "type": "Alert Card"},
          {"name": "Activity Chart", "span": "col-span-full lg:col-span-4", "type": "Live Chart"},
          {"name": "Relay Control", "span": "col-span-full md:col-span-6", "type": "Interactive Toggle"}
        ],
        "sleep_mode": [
          {"name": "Sleep State", "span": "col-span-full md:col-span-6", "type": "Hero Card"},
          {"name": "Respiration Rate", "span": "col-span-full md:col-span-6", "type": "Live Gauge"},
          {"name": "Movement Index", "span": "col-span-full", "type": "Area Chart"}
        ]
      }
    }
  },
  "components": {
    "library": "Shadcn UI (Customized)",
    "customizations": [
      "Remove rounded corners from Cards and Buttons for 'Lab' feel",
      "Use Serif font for Card Titles",
      "Use Mono font for all numeric data in Cards"
    ],
    "charts": "Recharts (Minimalist, thin lines, no grid lines)",
    "icons": "Lucide React (Stroke width 1.5px)"
  },
  "assets": {
    "images": [
      {
        "category": "Sleep Mode Background",
        "url": "https://images.unsplash.com/photo-1616180759411-6377a8c42307?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NTY2NzF8MHwxfHNlYXJjaHwyfHxwZXJzb24lMjBzbGVlcGluZyUyMHBlYWNlZnVsJTIwbWluaW1hbGlzdCUyMGJlZHJvb218ZW58MHx8fHwxNzY4NzExMzYzfDA&ixlib=rb-4.1.0&q=85",
        "description": "White bed beside window, minimalist, for sleep mode cover or empty state"
      }
    ]
  },
  "instructions_to_main_agent": [
    "Implement the 'Mode Switcher' as a primary navigation element.",
    "Ensure the 'Fall Detected' state triggers a visual alarm (Red border/background) but keeps the UI usable.",
    "Use the 'ESP32 Simulator' to populate charts with realistic dummy data when API is offline.",
    "Strictly follow the Typography rules: Serif for Headings, Mono for Data.",
    "Do not use rounded corners; keep it sharp and scientific.",
    "Add 'data-testid' to all interactive elements."
  ],
  "universal_guidelines": [
    "Avoid 'AI Slop' aesthetics (generic gradients, centered text).",
    "Use 2-3x more spacing than standard.",
    "Micro-animations for all interactions (hover, toggle).",
    "No 'Inter' for headings.",
    "Use 'sonner' for notifications."
  ]
}